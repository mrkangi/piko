<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 后台持续下载与上传：引导用户将 Piko 加入系统电池优化白名单，避免定制系统在切后台几分钟后冻结网络连接 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：经 PackageInstaller 安装从 GitHub Releases 下载的新版本 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 局域网共享与 SMB 回环流都是明文 HTTP（127.0.0.1 / 私有网段），系统默认策略会拦掉图片加载与部分播放器请求。 -->
    <application
        android:name=".PikoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Piko">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 注册为磁力、eD2k 与迅雷链接协议处理器 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
                <data android:scheme="ed2k" />
                <data android:scheme="thunder" />
            </intent-filter>
            <!-- 打开 .torrent 文件：在本地换算成磁力链接交给添加链接面板。文件管理器与浏览器下载
                 多按扩展名给出这个类型；报成 application/octet-stream 的认不出来，只能经分享上传 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- 官方 App 自定义协议，分享与普通内部路由由接收端区分。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pikpakapp" />
            </intent-filter>
            <!-- 官方「在 App 中打开」链接，Telegram 机器人存完文件后发的就是它。域名归官方 App
                 验证所有，这里不设 autoVerify；要由 Piko 打开，需在系统设置的「默认打开」里添加 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="toapp.mypikpak.com" />
                <data android:host="toapp.mypikpak.net" />
                <data android:host="toapp.pickpackapp.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="mypikpak.com" />
                <data android:host="www.mypikpak.com" />
                <data android:host="mypikpak.net" />
                <data android:host="www.mypikpak.net" />
                <data android:host="pikpak.me" />
                <data android:host="www.pikpak.me" />
                <data android:host="pikpakdrive.com" />
                <data android:host="www.pikpakdrive.com" />
                <data android:host="pickpackapp.com" />
                <data android:host="www.pickpackapp.com" />
                <data android:pathPrefix="/toapp" />
                <data android:pathPrefix="/deeplink" />
            </intent-filter>
            <!-- PikPak 分享链接：打开后在添加链接面板里浏览、勾选并转存。域名归官方验证所有，
                 不设 autoVerify；要由 Piko 直接打开，需在系统设置的「默认打开」里添加 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="mypikpak.com" />
                <data android:host="www.mypikpak.com" />
                <data android:host="mypikpak.net" />
                <data android:host="www.mypikpak.net" />
                <data android:host="pikpak.me" />
                <data android:host="www.pikpak.me" />
                <data android:host="pikpakdrive.com" />
                <data android:host="www.pikpakdrive.com" />
                <data android:host="pickpackapp.com" />
                <data android:host="www.pickpackapp.com" />
                <data android:pathPrefix="/s/" />
            </intent-filter>
            <!-- 注册接收外部文本分享（含磁力链接或分享链接的文本） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 接收外部分享的文件，上传到网盘。文本分享同样匹配，由 MainActivity 按有无 EXTRA_STREAM 区分 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 独立多窗口播放：每个槽位单独一个 taskAffinity，系统（Quest 的 Horizon OS、
             Android 自由窗口）会把它们显示成可以各自拖动缩放的窗口。固定 3 个槽位即上限，
             第 4 个视频复用最早失去焦点的槽位，不新建任务。 -->
        <activity
            android:name=".PlayerSlot0Activity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.player.slot0"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="576dp"
                android:minWidth="480dp"
                android:minHeight="270dp" />
        </activity>
        <activity
            android:name=".PlayerSlot1Activity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.player.slot1"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="576dp"
                android:minWidth="480dp"
                android:minHeight="270dp" />
        </activity>
        <activity
            android:name=".PlayerSlot2Activity"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.player.slot2"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="576dp"
                android:minWidth="480dp"
                android:minHeight="270dp" />
        </activity>

        <service
            android:name=".download.PikoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".download.RemoteDownloadService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote_download_receiver" />
        </service>

        <service
            android:name=".platform.AndroidLanShareService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="lan_file_share_host" />
        </service>

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
