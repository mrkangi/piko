FROM node:22-alpine AS web-builder
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-builder /internal/web/dist ./internal/web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -tags embed_ui -trimpath -ldflags="-s -w" -o /out/download-server ./cmd/server
RUN mkdir -p /out/data /out/tmp && \
    chown -R 10001:10001 /out/data && \
    chmod 1777 /out/tmp

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/download-server /download-server
COPY --from=builder --chown=10001:10001 /out/data /data
COPY --from=builder /out/tmp /tmp

USER 10001:10001
ENV HOME=/data \
    DOWNLOAD_SERVER_HOST=0.0.0.0 \
    DOWNLOAD_SERVER_PORT=7788 \
    DOWNLOAD_SERVER_DATA_DIR=/data/.pikpak/downloader

VOLUME ["/data"]
EXPOSE 7788
ENTRYPOINT ["/download-server"]
